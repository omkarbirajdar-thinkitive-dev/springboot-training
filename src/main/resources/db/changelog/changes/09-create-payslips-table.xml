<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="09-create-payslips-table" author="omkar">
        <createTable tableName="payslips">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="month" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="year" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="basic_salary" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="total_allowances" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="gross_salary" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="tax_deduction" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="other_deductions" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="net_salary" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>
            <column name="generated_by" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="generated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- FK: payslips.employee_id → employees.id -->
        <addForeignKeyConstraint
                baseTableName="payslips"
                baseColumnNames="employee_id"
                constraintName="fk_payslips_employee"
                referencedTableName="employees"
                referencedColumnNames="id"
                onDelete="CASCADE"
                onUpdate="RESTRICT"/>

        <!-- Unique constraint: one payslip per employee per month/year -->
        <addUniqueConstraint
                tableName="payslips"
                columnNames="employee_id, month, year"
                constraintName="uq_payslip_employee_month_year"/>
    </changeSet>

</databaseChangeLog>
